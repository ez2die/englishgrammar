# Copy to .env.local (preferred) or .env and fill in. NEVER commit the real file.

# ---- AI providers (set at least one; default provider is Qwen) ----
QWEN_API_KEY=your_qwen_api_key_here
# QWEN_API_BASE=https://coding.dashscope.aliyuncs.com/v1
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# CLAUDE_API_KEY=

# ---- Auth (REQUIRED in production) ----
# Strong random secret, >= 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=
# OAuth (only needed if social login is enabled)
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# ---- Runtime ----
PORT=3001
# NODE_ENV is provided by the process manager (ecosystem.config.cjs); avoid setting it here.
# Comma-separated origins allowed to call the API cross-origin in production:
# ALLOWED_ORIGINS=https://bankware.fun,https://www.bankware.fun
# Set to 1 only when running behind a reverse proxy (nginx):
# TRUST_PROXY=1
# Dev-only OAuth mock bypass — NEVER set true in production:
# ENABLE_AUTH_MOCKS=false
